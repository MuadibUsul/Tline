# SQLite for local dev (zero infra). Swap to a postgres:// URL for production + pgvector.
DATABASE_URL="file:./dev.db"

# Optional multi-provider LLM. Unset = deterministic parser; translation waits safely.
# LLM_PROVIDER="anthropic" # anthropic | openai
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-sonnet-4-5-20250929"
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-5.4"
# TRANSLATION_PROVIDER="anthropic"
# TRANSLATION_REVIEW_PROVIDER="openai"

# Private document storage and embedded PDF fonts.
# DOCUMENT_STORAGE_ROOT="./storage"
# PDF_FONT_EN="/path/to/regular.ttf"
# PDF_FONT_EN_BOLD="/path/to/bold.ttf"
# PDF_FONT_ZH="/path/to/cjk-regular.ttf"
# PDF_FONT_ZH_BOLD="/path/to/cjk-bold.ttf"
# PDF_FONT_ZH_FAMILY="PostScriptNameForTtc"
# PDF_FONT_ZH_BOLD_FAMILY="PostScriptNameForBoldTtc"
# PDF_LAYOUT_FONT_ZH="/path/to/cjk-layout.ttf"

# Required only for institutions explicitly marked requiresRender.
# PLAYWRIGHT_CHROMIUM_PATH="/path/to/chrome-or-edge"

# Signs the session cookie. Use a long random string in production.
AUTH_SECRET="dev-insecure-secret-change-me-in-prod"
