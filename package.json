{
  "name": "institutional-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Global Institutional Intelligence — turn institutional research into actionable signal.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "test": "tsx --test src/**/*.test.ts",
    "db:push": "prisma db push",
    "db:postgres:schema": "node scripts/generate-postgres-schema.mjs",
    "db:postgres:deploy": "node scripts/generate-postgres-schema.mjs && prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "ingest": "tsx src/lib/ingest/run.ts",
    "ingest:probe": "tsx src/lib/ingest/probe.ts",
    "macro:sync": "tsx src/lib/macro/sync.ts",
    "macro:calendar": "tsx src/lib/macro/calendar-cli.ts",
    "macro:watch": "tsx scripts/macro-release-watch.ts",
    "macro:policy": "tsx scripts/macro-policy-sync.ts",
    "macro:revision": "tsx scripts/macro-revision-sync.ts",
    "macro:alerts": "tsx scripts/macro-alerts.ts",
    "macro:scheduler": "node scripts/macro-scheduler.mjs",
    "social:scheduler": "tsx scripts/social-scheduler.ts",
    "social:diagnose": "tsx scripts/social-diagnose.ts",
    "daily:report": "tsx scripts/daily-report.ts",
    "members:founding": "tsx scripts/founding-members.ts",
    "macro:backfill": "tsx scripts/macro-backfill.ts",
    "macro:forecasts": "tsx prisma/macro-forecasts.ts",
    "macro:expectations": "tsx scripts/macro-expectations-sync.ts",
    "macro:repair": "tsx scripts/macro-repair-previous.ts",
    "macro:audit": "tsx scripts/macro-audit.ts",
    "reparse": "tsx prisma/reparse.ts",
    "retitle": "tsx prisma/retitle.ts",
    "dedupe:regional": "tsx prisma/dedupe-regional.ts",
    "watchdog": "tsx scripts/watchdog.ts",
    "translate": "tsx prisma/translate.ts",
    "translate:eval": "tsx prisma/translate-eval.ts",
    "documents": "tsx prisma/documents.ts",
    "consensus": "tsx src/lib/ingest/recompute.ts",
    "forecasts": "tsx prisma/forecasts.ts",
    "prices:import": "tsx prisma/prices.ts",
    "alerts": "tsx prisma/demo-user.ts",
    "scheduler": "node scripts/scheduler.mjs",
    "dataset:export": "tsx scripts/dataset.ts export",
    "dataset:import": "tsx scripts/dataset.ts import",
    "user:password": "tsx scripts/set-password.ts",
    "licenses": "tsx scripts/license-confirm.ts",
    "mail:test": "node scripts/mail-test.mjs",
    "env:check": "node scripts/validate-env.mjs",
    "env:check:production": "node scripts/validate-env.mjs --production",
    "setup": "prisma db push && tsx prisma/seed.ts && tsx prisma/demo-user.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "audit:prod": "npm audit --omit=dev --registry=https://registry.npmjs.org",
    "typecheck": "tsc --noEmit",
    "backup": "node scripts/backup.mjs",
    "backup:verify": "node scripts/backup.mjs --verify",
    "retries": "tsx scripts/content-retries.ts",
    "analysis:grounding": "tsx scripts/analysis-grounding.ts",
    "translate:rescore": "tsx scripts/translation-quality.ts",
    "macro:market": "tsx scripts/market-sync.ts",
    "macro:expectation": "tsx scripts/macro-expectation.ts",
    "themes:snapshot": "tsx scripts/trading-theme-snapshot.ts",
    "analytics:rollup": "tsx scripts/analytics-rollup.ts",
    "seo:status": "tsx scripts/seo-status.ts",
    "classification:shadow": "tsx scripts/classification-shadow.ts",
    "classification:eval": "tsx scripts/classification-eval.ts",
    "classification:backfill": "tsx scripts/classification-backfill.ts",
    "decision:consistency": "tsx scripts/decision-shadow.ts consistency",
    "decision:policy": "tsx scripts/decision-shadow.ts policy",
    "decision:views": "tsx scripts/decision-shadow.ts views"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@aws-sdk/s3-request-presigner": "^3.1119.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^5.22.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "next": "^15.5.25",
    "next-auth": "^4.24.15",
    "nodemailer": "^9.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pdfkit": "^0.20.1",
    "pinyin-pro": "^3.29.3",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "domhandler": "^5.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.25",
    "prisma": "^5.22.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.32.1"
  },
  "overrides": {
    "postcss": "8.5.28",
    "next-auth": {
      "nodemailer": "$nodemailer"
    }
  }
}
