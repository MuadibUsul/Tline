# SQLite for local dev (zero infra). Production deployment uses PostgreSQL.
DATABASE_URL="file:./dev.db"

# Optional multi-provider LLM. Unset = deterministic parser; translation waits safely.
# LLM_PROVIDER="anthropic" # anthropic | openai | deepseek | gemini
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-sonnet-4-5-20250929"
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-5.4"
# DEEPSEEK_API_KEY="sk-..."
# DEEPSEEK_MODEL="deepseek-v4-flash"
# DEEPSEEK_BASE_URL="https://api.deepseek.com"
# GEMINI_API_KEY="AIza..." # free tier: https://aistudio.google.com/apikey
# GEMINI_MODEL="gemini-2.0-flash"
# TRANSLATION_PROVIDER="anthropic"
# TRANSLATION_REVIEW_PROVIDER="openai"
# FORECAST_PROVIDER="deepseek"

# Everything above is now also settable in the console (Platform -> Model providers), which
# takes precedence. These stay as the fallback, so a deployment that never opens the console
# behaves exactly as before.
#
# Encrypts provider keys stored from the console. Falls back to AUTH_SECRET if unset.
# Rotating it makes stored keys unreadable and they must be entered again.
# CONFIG_ENCRYPTION_KEY="a-long-random-value"
# LLM_CONFIG_CACHE_MS="30000"   # how long a worker caches console config before re-reading
# LLM_CALL_RETENTION_DAYS="90"  # per-call usage rows are pruned by the analytics rollup
# One model for every provider that has no per-provider model set. A per-provider value wins,
# and a console route wins over both. Anthropic and OpenAI also fall back to it; Gemini
# deliberately does not, because an OpenAI model name sent to Gemini is never valid.
# LLM_MODEL=""
# OPENAI_BASE_URL="https://api.openai.com"
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com"
# How long a budget verdict is trusted. Lower reacts to a runaway job sooner, at one extra
# aggregation query per task per window.
# LLM_BUDGET_CACHE_MS="15000"
# The emergency stop. Any of 1/true/yes halts every model call immediately — it is read from
# the environment rather than the database on purpose, because the moment you need it is the
# moment you are trying to stop a bill that is already running, and a worker's cached config
# is the last thing you want to wait for.
# LLM_DISABLED="false"

# Typed decision provider. It is intentionally separate from LLM_PROVIDER and shadow-only:
# outcomes are recorded for comparison but cannot change the production classification.
# JEV_DECISION_ENABLED="false"
# JEV_SHADOW_MODE="true"
# JEV_API_KEY=""
# Accepted alias for JEV_API_KEY, for a deployment whose secret store already uses the
# vendor's own name. JEV_API_KEY wins when both are set.
# TYPESAFE_API_KEY=""
# JEV_MODEL="jev-latest"
# JEV_BASE_URL="https://api.typesafe.ai"
# JEV_TIMEOUT_MS="20000"
# JEV_CLASSIFICATION_EXCERPT_CHARS="6000"
# JEV_MIN_INTERVAL_MS="1000"
# JEV_MAX_FAILURES="3"
# JEV_RETRY_BASE_MS="60000"
# JEV_RETRY_MAX_MS="3600000"
# JEV_CLASSIFICATION_APPLY_ENABLED="false" # separately authorizes --persist-decisions
# JEV_CLASSIFICATION_REVIEW_THRESHOLD="0.65"
# JEV_CLASSIFICATION_AUTO_THRESHOLD="0.90"
# AI_PREFLIGHT_ENABLED="false"       # records JEV SKIP/LIGHT/DEEP advice; never gates by itself
# LLM_HARD_GATE_ENABLED="false"      # requires formal eval approval below
# JEV_GATE_EVAL_APPROVED="false"     # operational sign-off, never inferred from a small sample
# AI_HARD_GATE_TASKS="retitle"       # comma-separated low-risk allowlist
# JEV_GATE_MIN_CONFIDENCE="0.95"

# Context budgets are adjustable without changing prompts or code.
# AI_CONTEXT_ANALYSIS_PREFERRED_TOKENS="6000"
# AI_CONTEXT_ANALYSIS_MAX_TOKENS="16000"
# AI_CONTEXT_FORECAST_PREFERRED_TOKENS="6000"
# AI_CONTEXT_FORECAST_MAX_TOKENS="16000"

# Cost controls for the content pipeline.
# Characters per translation request. Larger is cheaper (fewer calls) but past some size the
# model starts dropping segments, which fails the integrity check and re-requests the chunk.
# TRANSLATION_CHUNK_CHARS="6000"
# Share of structurally sound translations that still get the paid independent review.
# Anything the cheap quality signals flag is reviewed regardless of this rate.
# TRANSLATION_REVIEW_SAMPLE_RATE="0.15"
# Per-article backoff after a stage fails, so an unprocessable article stops being re-billed.
# ARTICLE_LLM_MAX_FAILURES="6"
# ARTICLE_LLM_BACKOFF_MS="1800000"
# ARTICLE_LLM_BACKOFF_MAX_MS="86400000"
# Macro read-out generation: attempts before a release is abandoned, and the first backoff.
# MACRO_RELEASE_ANALYSIS_MAX_ATTEMPTS="3"
# MACRO_RELEASE_ANALYSIS_BACKOFF_MS="900000"
# MACRO_RELEASE_ANALYSIS_INTERVAL_MS="900000"
# When the Chinese-completeness rule starts to bite. A report first seen on or after this
# instant must carry a Chinese translation before it appears on a Chinese address; everything
# older is grandfathered, so moving this never reaches back into existing content. Set it to
# the deployment time when you want the rule to apply from now on.
# LOCALE_STRICT_ZH_SINCE="2026-09-15T00:00:00Z"
# Articles translated per scheduler pass. Bounded so one pass cannot run for the whole
# interval and overlap the next.
# TRANSLATION_ARTICLE_LIMIT="20"
# Backfilling Chinese translations is OFF by default (0), and that default is the point: in
# the per-minute scheduler a backlog limit is a standing bill, not a one-off cost. Run the
# backfill by hand in batches (`prisma/translate.ts --backlog --limit=25 --concurrency=4`) and
# leave this at 0. `TRANSLATION_BACKLOG` is the environment equivalent of the `--backlog` flag.
# TRANSLATION_BACKLOG_LIMIT="0"
# TRANSLATION_BACKLOG="false"
# Environment equivalent of `reparse --stale-prompt`: re-parse articles whose stored analysis
# was written by an older prompt. Changing the prompt version makes every article stale, so
# this is the second half of that switch — see the warning on PROMPT_VERSION.
# REPARSE_STALE_PROMPT="false"
# How far back the topic layer looks when counting coverage. 365 days by default; the pages
# want a year of history, not a week of it.
# TOPIC_WINDOW_DAYS="365"

# Private document storage and embedded PDF fonts.
# DOCUMENT_STORAGE_DRIVER="local"
# DOCUMENT_STORAGE_ROOT="./storage"
# DOCUMENT_MAX_BYTES="52428800"
# S3_BUCKET="private-tline-documents"
# S3_REGION="us-east-1"
# S3_PREFIX="tline"
# S3_ENDPOINT="https://s3-compatible-endpoint.example"
# S3_FORCE_PATH_STYLE="false"
# S3_SERVER_SIDE_ENCRYPTION="AES256"
# S3_SIGNED_URL_TTL_SECONDS="300"
# The S3 client is built without explicit credentials, so it resolves them through the AWS
# default chain — for a plain access-key deployment that means these two names, which the SDK
# reads itself and this application never touches. On EC2/ECS with a role, set neither.
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# PDF_FONT_EN="/path/to/regular.ttf"
# PDF_FONT_EN_BOLD="/path/to/bold.ttf"
# PDF_FONT_ZH="/path/to/cjk-regular.ttf"
# PDF_FONT_ZH_BOLD="/path/to/cjk-bold.ttf"
# PDF_FONT_ZH_FAMILY="PostScriptNameForTtc"
# PDF_FONT_ZH_BOLD_FAMILY="PostScriptNameForBoldTtc"
# PDF_LAYOUT_FONT_ZH="/path/to/cjk-layout.ttf"

# Required only for institutions explicitly marked requiresRender.
# PLAYWRIGHT_CHROMIUM_PATH="/path/to/chrome-or-edge"

# Scheduler observability/retry policy.
# Where the scheduler keeps its single-instance lock and other run state. The default is
# `./.runtime`; the container image points it at a writable path.
# RUNTIME_DIR=".runtime"
# The hour (Asia/Shanghai) the daily operations report is posted once a day. The loop ticks
# every ten minutes and only fires at this hour, so a missed tick is retried, not skipped.
# DAILY_REPORT_HOUR="8"
# INGEST_INTERVAL_MS="60000"
# INGEST_CONCURRENCY="2"
# INGEST_SOURCE_SECONDS="90"
# INGEST_ARTICLE_LIMIT="4"
# How far back a discovery pass looks. Older items are skipped, so the parse,
# translation and analysis spend stays on research that is actually current. Seven days
# by default: most desks publish weekly or less, and a shorter window excludes them.
# INGEST_WINDOW_HOURS="168"
# PROCESS_INTERVAL_MS="60000"
# PROCESS_ARTICLE_LIMIT="50"
# REPARSE_CONCURRENCY="2"
# TRANSLATION_CONCURRENCY="2"
# JOB_RETRY_LIMIT="3"
# JOB_RETRY_DELAY_MS="60000"
# JOB_FAILURE_WEBHOOK_URL="https://internal-alert-endpoint.example/hooks/tline"
# The watchdog reports the failure mode a healthy process cannot detect on its own: every pass
# succeeds and nothing is ever captured. It compares the newest article against these ages and
# exits non-zero (which the scheduler surfaces) once a pipeline has gone quiet for this long.
# INGEST_STALL_HOURS="6"
# VIEW_STALL_HOURS="12"
# Macro scheduler runs as a separate singleton process/container.
# MACRO_CALENDAR_INTERVAL_MS="21600000"
# Half-hourly: a survey consensus has to be captured well before the print it describes, and
# well inside the calendar feed's two-downloads-per-five-minutes request budget.
# MACRO_EXPECTATION_SYNC_INTERVAL_MS="1800000"
# MACRO_PROVIDER_SYNC_INTERVAL_MS="3600000"
# MACRO_RELEASE_WATCH_INTERVAL_MS="60000"
# MACRO_REVISION_SYNC_INTERVAL_MS="86400000"
# MACRO_POLICY_SYNC_INTERVAL_MS="21600000"
# MACRO_ALERT_INTERVAL_MS="60000"
# Market quote polling. One request per instrument per pass; Twelve Data's free tier
# allows 800/day, so the 30-minute default keeps 7 instruments at ~336 and leaves room
# for a --from= backfill. Raise the frequency only on a paid plan.
# MACRO_MARKET_SYNC_INTERVAL_MS="1800000"
# Rebuilds the trading-theme snapshot from a 14-day view window and an 8-day market window.
# THEME_MARKET_MIN_COVERAGE (below) decides how much of a theme prices must confirm to publish.
# THEME_SNAPSHOT_INTERVAL_MS="1800000"
# MACRO_FORECAST_SETTLE_INTERVAL_MS="21600000"
# MACRO_JOB_RETRY_LIMIT="3"
# MACRO_JOB_RETRY_DELAY_MS="30000"

# Signs the session cookie. Use a long random string in production.
AUTH_SECRET="dev-insecure-secret-change-me-in-prod"
ADMIN_EMAILS="owner@example.com"
# AUTH_PROVIDER="email" # email | azure-ad | google
# NEXTAUTH_URL="https://tline.example.com"
# Resend SMTP: verify the sender domain first, then use a restricted API key.
# EMAIL_SERVER="smtp://resend:re_xxxxxxxxx@smtp.resend.com:587"
# EMAIL_FROM="Tline <no-reply@tline.example.com>"
# AZURE_AD_CLIENT_ID=""
# AZURE_AD_CLIENT_SECRET=""
# AZURE_AD_TENANT_ID="common"
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# AUTH_ALLOWED_EMAIL_DOMAINS="example.com,subsidiary.example"
# Password sign-in throttling: attempts from one address inside the window before it is locked
# out for the remainder of that window. The counter is in-process, so it resets with the app.
# PASSWORD_ATTEMPT_LIMIT="10"
# PASSWORD_ATTEMPT_WINDOW_MS="900000"
# Seats in the founding-membership programme. The cap is enforced where it cannot be raced: the
# seat is a unique column and the lowest free one is allocated inside a transaction.
# FOUNDING_MEMBERSHIP_LIMIT="100"
# PRICE_SETTLEMENT_TOLERANCE_DAYS="7"
# Official U.S. macro APIs. BLS key is optional; the other providers require one.
# BLS_API_KEY=""
# BEA_API_KEY=""
# FRED_API_KEY=""
# FRED_DATA_USE_CONFIRMED="false" # enable only after current FRED/series terms are reviewed for this use
# EIA_API_KEY=""
# Licensed market data. Quality defaults to DELAYED; set REALTIME only when the account entitlement guarantees it.
# TWELVE_DATA_API_KEY=""
# TWELVE_DATA_QUALITY="DELAYED" # DELAYED | REALTIME | EOD
# TWELVE_DATA_DECLARED_DELAY_SECONDS="900" # contractual/provider-declared delay, not our sampling interval
# MARKET_BUDGET_PER_MINUTE="8"
# MARKET_BUDGET_PER_DAY="800"
# MARKET_BUDGET_RESET_TIMEZONE="UTC"
# MARKET_QUOTE_ENDPOINT_WEIGHT="1"
# MARKET_TIME_SERIES_ENDPOINT_WEIGHT="1"
# THEME_MARKET_MIN_COVERAGE="0.6"
# Email-only sign-in is preview-only and disabled in production unless explicitly opted in.
# ALLOW_INSECURE_DEMO_AUTH="false"

# ---- Public site identity ----
# Canonical origin used by robots.txt, sitemap.xml and Open Graph URLs.
# Production validation requires this value and it must use HTTPS.
# SITE_URL="https://tlines.tech"
# Comma-separated official organization profile URLs; leave empty rather than inventing identities.
# BRAND_SAME_AS="https://www.linkedin.com/company/your-official-profile"
# Founding date for the Organization schema. Omitted entirely when unset, because a made-up
# date is worse than no date.
# BRAND_FOUNDED=""
# URLs per sitemap shard. Articles keep their shard for life (the shard order is oldest-first),
# so a new article never rewrites the shards before it. Minimum 100.
# SITEMAP_SHARD_SIZE="2000"

# ---- Health endpoint ----
# /api/health returns only { status } to anonymous callers. Operators with an admin
# session see the full detail; an external uptime monitor can use this bearer token.
# HEALTH_DETAIL_TOKEN=""

# ---- Search protection ----
# Fixed-window limit per client on /api/search, which builds an in-memory index.
# SEARCH_RATE_LIMIT="30"
# SEARCH_RATE_WINDOW_MS="60000"
# Upper bound on articles held in the search index; oldest fall out beyond it.
# SEARCH_INDEX_MAX_ARTICLES="1000"
# Trust `x-forwarded-for` when identifying a client. Off by default, because a deployment that
# is not actually behind a trusted proxy would let any caller forge the header and reset its
# own limit. Turn it on behind Caddy (the production compose does). Both limiters read it:
# /api/search and the per-key limit on /api/v1.
# TRUST_PROXY_HEADERS="false"
# SEARCH_PREWARM="true"
# How long the index's data-version fingerprint is trusted before it is probed again.
# SEARCH_VERSION_PROBE_MS="10000"

# ---- Content reprocessing ----
# Operator-requested reruns drained per scheduler pass.
# CONTENT_RETRY_BATCH="5"

# ---- Public API metering ----
# Per-key request counts are buffered in memory and flushed as increments; this is how long a
# flush may wait before it is forced by size instead.
# API_USAGE_FLUSH_MS="10000"

# ---- Fetch caches ----
# Conditional-request caches the crawler keeps on disk, so a re-crawl of an unchanged page
# costs one 304 rather than a full body. Both default under ./data/cache.
# HTTP_CACHE_ROOT="./data/cache/http"
# ROBOTS_CACHE_ROOT="./data/cache/robots"

# ---- Alert delivery ----
# Fired alerts POST to each user's own https webhook; this is the fallback for users
# who have not configured one. Private and loopback addresses are refused.
# ALERT_WEBHOOK_URL=""
# ALERT_DELIVERY_ATTEMPTS="3"

# ---- Human-approved social publishing ----
# X OAuth app. Register https://YOUR_SITE/api/social/x/callback as the callback URL.
# X_CLIENT_ID=""
# X_CLIENT_SECRET=""
# Feishu custom app bot and interactive-card callback credentials.
# FEISHU_ENCRYPT_KEY is REQUIRED for the approve/reject card callbacks: without it
# the request signature has no secret and the endpoint rejects every callback.
# FEISHU_APP_ID=""
# FEISHU_APP_SECRET=""
# FEISHU_ENCRYPT_KEY=""
# FEISHU_VERIFICATION_TOKEN=""
# FEISHU_REVIEW_RECEIVE_ID=""
# FEISHU_REVIEW_RECEIVE_ID_TYPE="open_id"
# FEISHU_APPROVER_OPEN_IDS="ou_xxx,ou_yyy"
# Set to "1" to log every Feishu webhook request (noisy; off by default).
# FEISHU_DEBUG=""
# SOCIAL_INTERVAL_MS="5000"
# SOCIAL_PUBLISH_ATTEMPTS="6"
# SOCIAL_RESEARCH_REVIEW_HOURS="48"
# SOCIAL_RESEARCH_REVIEW_PER_CYCLE="25"
# Attempts before a stuck (undeliverable) review card is recorded in the audit log.
# SOCIAL_NOTIFY_ALERT_ATTEMPTS="5"

# ---- Backups ----
# BACKUP_DIR="backups"
# BACKUP_KEEP="7"

# ---- Audience analytics ----
# First-party, cookie-less measurement. No IP address is ever stored: a visitor is a
# daily-rotating digest of (AUTH_SECRET + UTC day + address + user agent), so a reader is
# countable once per day and unlinkable across days.
# Set to "false" to stop collecting entirely; the console then shows empty dashboards
# rather than breaking.
ANALYTICS_ENABLED="true"
# Honour Do-Not-Track / Global Privacy Control. Costs a fraction of a percent of the
# counts; enable it where the deployment's audience expects it.
ANALYTICS_RESPECT_DNT="false"
# How long raw page views, events and vitals are kept before the rollup job deletes them.
# Daily aggregates are kept indefinitely, so history survives the pruning.
ANALYTICS_RAW_RETENTION_DAYS="90"
# Beacons accepted per address per minute. A page sends roughly one per view plus one on
# leaving, so this is generous for a reader and closed to a script.
ANALYTICS_RATE_LIMIT="120"
# How often the scheduler recomputes daily aggregates and prunes raw rows. Minimum 5 min.
ANALYTICS_ROLLUP_INTERVAL_MS="3600000"
