// Institutional Intelligence — Phase 1 schema (SQLite dev).
// Swap datasource to postgresql + add pgvector columns for production search.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Institution {
  id                  String    @id @default(cuid())
  slug                String    @unique
  name                String
  country             String?
  homepage            String?
  researchUrl         String
  rssUrl              String?
  sitemapUrl          String?
  rating              Int       @default(4) // stars 3..5 from the source list
  authorityScore      Float     @default(0.85) // 0..1 weight used by the consensus engine
  priority            Int       @default(3) // 1 = phase-1 high-value source
  updateFreq          String? // annual estimate from the source list
  language            String    @default("en")
  crawlPolicy         String    @default("allowed") // allowed | delayed | blocked | manual (from robots audit)
  monitoringEnabled   Boolean   @default(true) // operational pause; never overrides crawlPolicy
  crawlDelay          Int? // seconds; from robots Crawl-delay, honored by the crawler
  requiresRender      Boolean   @default(false) // explicit opt-in for public JS-rendered pages
  crawlIntervalSec    Int? // null selects RSS/static/render defaults (60/180/600 seconds)
  nextCrawlAt         DateTime?
  consecutiveFailures Int       @default(0)
  lastCrawlAt         DateTime?
  lastCrawlStatus     String? // running | succeeded | empty | paused | refused | failed
  lastCrawlMessage    String?
  lastSuccessAt       DateTime?
  lastDiscoveredAt    DateTime?
  createdAt           DateTime  @default(now())

  articles       Article[]
  forecasts      Forecast[]
  macroForecasts MacroForecast[]

  @@index([monitoringEnabled, nextCrawlAt])
}

model Article {
  id             String   @id @default(cuid())
  institutionId  String
  title          String
  author         String?
  publishedAt    DateTime
  sourceUrl      String
  language       String   @default("en")
  urlHash        String   @unique
  titleHash      String
  contentHash    String
  rawText        String? // canonical cleaned English body; access is permission-controlled
  disclaimerText String? // publisher legal disclosure, excluded from analysis/translation
  createdAt      DateTime @default(now())

  institution   Institution          @relation(fields: [institutionId], references: [id])
  analysis      Analysis?
  articleAssets ArticleAsset[]
  segments      ArticleSegment[]
  translations  ArticleTranslation[]
  documents     ArticleDocument[]
  atomicViews    AtomicView[]
  figures        ArticleFigure[]
  macroForecasts MacroForecast[]
  contentRetries ContentRetry[]

  @@index([institutionId, publishedAt])
  // The home feed and /research order globally by recency; without this the planner sorts the whole table.
  @@index([publishedAt])
  @@index([titleHash])
  @@index([contentHash])
}

model AtomicView {
  id            String   @id @default(cuid())
  articleId     String
  position      Int
  viewEn        String
  viewZh        String
  type          String // forecast | target | direction | conditional | risk | rationale | market_impact
  asset         String
  assetTicker   String?
  topic         String
  direction     String // bullish | bearish | neutral | conditional
  timeHorizon   String
  value         String?
  conditionEn   String?
  conditionZh   String?
  rationaleEn   String?
  rationaleZh   String?
  confidence    String // high | medium | low
  importance    Int // 1..5
  sourceQuote   String
  provider      String
  model         String
  promptVersion String
  reviewStatus  String   @default("ok")
  createdAt     DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, position])
  @@index([assetTicker, direction])
  @@index([type, importance])
  @@index([topic])
}

model Analysis {
  id               String   @id @default(cuid())
  articleId        String   @unique
  summary          String
  summaryZh        String?
  keyArguments     String   @default("[]") // JSON string
  keyArgumentsZh   String   @default("[]")
  keyNumbers       String   @default("[]") // JSON string [{label,value}]
  keyNumbersZh     String   @default("[]")
  risks            String   @default("[]") // JSON string
  risksZh          String   @default("[]")
  interpretation   String? // AI trading interpretation
  interpretationZh String?
  importanceScore  Float    @default(0.5)
  confidence       Float    @default(0.6)
  provider         String   @default("local")
  model            String   @default("mock-rules-v1")
  promptVersion    String   @default("v1")
  reviewStatus     String   @default("ok") // ok | needs_review
  createdAt        DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model ArticleSegment {
  id        String  @id @default(cuid())
  articleId String
  position  Int
  heading   String?
  text      String

  article            Article                     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  translatedSegments ArticleTranslationSegment[]

  @@unique([articleId, position])
  @@index([articleId])
}

model ArticleFigure {
  id                   String   @id @default(cuid())
  articleId            String
  afterSegmentPosition Int // render after the body segment at this position; identical in EN and ZH
  ordinal              Int // order among figures sharing the same anchor
  storageKey           String
  mimeType             String   @default("image/jpeg")
  sourceUrl            String
  alt                  String?
  caption              String?
  width                Int?
  height               Int?
  byteSize             Int?
  createdAt            DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, afterSegmentPosition, ordinal])
  @@index([articleId])
}

model ArticleTranslation {
  id              String   @id @default(cuid())
  articleId       String
  locale          String   @default("zh-CN")
  title           String
  text            String
  provider        String
  model           String
  promptVersion   String
  glossaryVersion String
  status          String   @default("translated") // translated | reviewed | needs_review
  qualityScore    Float?
  translatedAt    DateTime @default(now())
  updatedAt       DateTime @updatedAt

  article   Article                     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  segments  ArticleTranslationSegment[]
  documents ArticleDocument[]

  @@unique([articleId, locale])
  @@index([status, translatedAt])
}

model ArticleTranslationSegment {
  id              String  @id @default(cuid())
  translationId   String
  sourceSegmentId String
  position        Int
  heading         String?
  text            String

  translation   ArticleTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)
  sourceSegment ArticleSegment     @relation(fields: [sourceSegmentId], references: [id], onDelete: Cascade)

  @@unique([translationId, position])
  @@index([sourceSegmentId])
}

model ArticleDocument {
  id            String   @id @default(cuid())
  articleId     String
  translationId String?
  kind          String // source_native | original_pdf | translation_pdf
  locale        String
  storageKey    String
  contentHash   String?
  mimeType      String   @default("application/pdf")
  pageCount     Int?
  byteSize      Int?
  sourceUrl     String?
  status        String   @default("pending") // pending | processing | ready | failed
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  article     Article             @relation(fields: [articleId], references: [id], onDelete: Cascade)
  translation ArticleTranslation? @relation(fields: [translationId], references: [id], onDelete: SetNull)

  @@unique([articleId, kind, locale])
  @@index([status, createdAt])
}

/// Operator-requested reprocessing of one article's AI output, with the outcome recorded.
/// Without the outcome a "retry" is just a wish: the point is being able to say whether the
/// rerun actually improved the score, left it alone, or failed.
model ContentRetry {
  id            String    @id @default(cuid())
  articleId     String
  kind          String // analysis | translation
  status        String    @default("queued") // queued | running | succeeded | failed
  requestedById String?
  requestedAt   DateTime  @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  attempt       Int       @default(0)
  scoreBefore   Float?
  scoreAfter    Float?
  error         String?

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, kind])
  @@index([status, requestedAt])
}

model Asset {
  id         String @id @default(cuid())
  ticker     String @unique
  name       String
  assetClass String // equity | rate | fx | commodity | crypto | macro
  aliases    String @default("[]") // JSON string of match terms

  articleAssets     ArticleAsset[]
  forecasts         Forecast[]
  consensusHistory  ConsensusHistory[]
  priceObservations PriceObservation[]
}

model ArticleAsset {
  id             String   @id @default(cuid())
  articleId      String
  assetId        String
  direction      Int // -2 strong bear .. +2 strong bull
  target         Float?
  previousTarget Float?
  timeHorizon    String? // 1W | 1M | 3M | 12M
  confidence     Float    @default(0.6)
  createdAt      DateTime @default(now())

  article  Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  asset    Asset     @relation(fields: [assetId], references: [id])
  forecast Forecast?

  @@unique([articleId, assetId])
  @@index([assetId, direction])
}

model Forecast {
  id               String    @id @default(cuid())
  institutionId    String
  assetId          String
  articleAssetId   String?   @unique
  forecastDate     DateTime
  targetDate       DateTime?
  targetValue      Float?
  metric           String?
  direction        Int?
  status           String    @default("pending") // pending | settled
  baseValue        Float?
  actualValue      Float?
  absoluteError    Float?
  percentageError  Float?
  directionCorrect Boolean?
  settlementSource String?
  settledAt        DateTime?

  institution  Institution   @relation(fields: [institutionId], references: [id])
  asset        Asset         @relation(fields: [assetId], references: [id])
  articleAsset ArticleAsset? @relation(fields: [articleAssetId], references: [id], onDelete: Cascade)

  @@index([assetId, forecastDate])
  @@index([institutionId, status])
  @@index([status, targetDate])
}

model PriceObservation {
  id        String   @id @default(cuid())
  assetId   String
  timestamp DateTime
  value     Float
  source    String
  sourceRef String?
  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, timestamp, source])
  @@index([assetId, timestamp])
}

model ConsensusHistory {
  id               String   @id @default(cuid())
  assetId          String
  timestamp        DateTime @default(now())
  consensusScore   Int // 0..100
  institutionCount Int
  bullishCount     Int
  neutralCount     Int
  bearishCount     Int

  asset Asset @relation(fields: [assetId], references: [id])

  @@index([assetId, timestamp])
}

// ---- Macro Intelligence. Independent from Article ingest and Institutional Consensus. ----

model MacroIndicator {
  id                 String   @id @default(cuid())
  canonicalKey       String   @unique
  nameEn             String
  nameZh             String?
  countryCode        String
  currency           String?
  category           String
  frequency          String
  unit               String
  seasonalAdjustment String?
  importance         Int      @default(3)
  enabled            Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  seriesSources MacroSeriesSource[]
  releaseValues MacroReleaseValue[]

  @@index([countryCode, category, enabled])
}

model MacroSeriesSource {
  id               String   @id @default(cuid())
  indicatorId      String
  provider         String
  externalSeriesId String
  dataset          String?
  tableCode        String?
  lineCode         String?
  priority         Int      @default(100)
  sourceUrl        String?
  metadata         String? // JSON string; SQLite has no Prisma Json support
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  indicator    MacroIndicator     @relation(fields: [indicatorId], references: [id], onDelete: Restrict)
  observations MacroObservation[]

  @@unique([provider, externalSeriesId])
  @@index([indicatorId, enabled, priority])
}

model MacroObservation {
  id                String    @id @default(cuid())
  seriesSourceId    String
  period            DateTime
  value             Decimal
  vintageAt         DateTime
  fetchedAt         DateTime
  isInitial         Boolean   @default(false)
  revisionNo        Int       @default(0)
  status            String    @default("PUBLISHED")
  sourcePublishedAt DateTime?
  rawHash           String?
  metadata          String? // JSON string
  createdAt         DateTime  @default(now())

  seriesSource MacroSeriesSource @relation(fields: [seriesSourceId], references: [id], onDelete: Restrict)

  @@unique([seriesSourceId, period, vintageAt])
  @@unique([seriesSourceId, period, revisionNo])
  @@index([seriesSourceId, vintageAt])
  @@index([period, status])
}

model MacroRelease {
  id                String    @id @default(cuid())
  releaseKey        String    @unique
  releaseFamily     String
  countryCode       String
  currency          String?
  agency            String
  titleEn           String
  titleZh           String?
  scheduledAt       DateTime
  sourceTimezone    String
  releasedAt        DateTime?
  importance        Int       @default(3)
  status            String    @default("SCHEDULED")
  sourceUrl         String?
  externalReleaseId String?
  analysisEn        String? // AI read-out generated on release (actual vs consensus/previous)
  analysisZh        String?
  analysisAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  values          MacroReleaseValue[]
  policyDocuments MacroPolicyDocument[]

  @@index([status, scheduledAt])
  @@index([releaseFamily, scheduledAt])
  @@index([agency, externalReleaseId])
}

model MacroForecast {
  id              String   @id @default(cuid())
  institutionId   String
  indicatorKey    String // canonical indicator key, e.g. US_NFP
  referencePeriod DateTime // first day of the forecast month/quarter
  value           Float
  unit            String?
  quote           String?
  articleId       String? // source research article
  asOf            DateTime // article publication time (recency for de-duplication)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  article     Article?    @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@unique([institutionId, indicatorKey, referencePeriod])
  @@index([indicatorKey, referencePeriod])
}

model MacroReleaseValue {
  id                       String    @id @default(cuid())
  releaseId                String
  indicatorId              String
  observationPeriod        DateTime
  actualInitial            Decimal?
  previousAtRelease        Decimal?
  revisedPreviousAtRelease Decimal?
  consensusAtRelease       Decimal?
  consensusProvider        String?
  consensusAsOf            DateTime?
  surpriseRaw              Decimal?
  surprisePct              Decimal?
  fetchedAt                DateTime
  createdAt                DateTime  @default(now())

  release   MacroRelease   @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  indicator MacroIndicator @relation(fields: [indicatorId], references: [id], onDelete: Restrict)

  @@unique([releaseId, indicatorId])
  @@index([indicatorId, observationPeriod])
}

model MacroPolicyDocument {
  id            String    @id @default(cuid())
  releaseId     String?
  centralBank   String
  docType       String
  meetingDate   DateTime?
  publishedAt   DateTime
  sourceUrl     String
  rawText       String
  contentHash   String
  parsedJson    String? // JSON string
  provider      String?
  model         String?
  promptVersion String?
  reviewStatus  String    @default("unparsed")
  fetchedAt     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  release MacroRelease? @relation(fields: [releaseId], references: [id], onDelete: SetNull)

  @@unique([sourceUrl, contentHash])
  @@index([releaseId])
  @@index([centralBank, docType, publishedAt])
  @@index([contentHash])
}

model MacroSyncState {
  id            String    @id @default(cuid())
  provider      String
  scopeKey      String
  cursor        String?
  etag          String?
  lastModified  String?
  lastAttemptAt DateTime?
  lastSuccessAt DateTime?
  lastStatus    String    @default("never")
  lastError     String?
  metadata      String? // JSON string
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([provider, scopeKey])
  @@index([lastStatus, lastSuccessAt])
}

model MarketInstrument {
  id            String   @id @default(cuid())
  symbol        String   @unique
  baseAsset     String
  quoteCurrency String
  assetClass    String
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  observations MarketObservation[]

  @@index([assetClass, enabled])
}

model MarketObservation {
  id             String   @id @default(cuid())
  instrumentId   String
  provider       String
  externalSymbol String
  observedAt     DateTime
  fetchedAt      DateTime
  interval       String
  quoteCurrency  String
  quality        String
  status         String
  open           Decimal?
  high           Decimal?
  low            Decimal?
  close          Decimal
  sourceUrl      String?
  rawHash        String?
  metadata       String?
  createdAt      DateTime @default(now())

  instrument MarketInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([provider, externalSymbol, observedAt, interval])
  @@index([instrumentId, observedAt])
  @@index([quality, fetchedAt])
}

model MacroSignalSnapshot {
  id                  String   @id @default(cuid())
  scopeKey            String   @default("GLOBAL")
  methodologyVersion  String
  generatedAt         DateTime
  contextJson         String
  inputReleaseIds     String
  inputObservationIds String
  createdAt           DateTime @default(now())

  @@index([scopeKey, generatedAt])
  @@index([methodologyVersion, generatedAt])
}

// ---- User side (Phase 2). Refs to assets/institutions are scalar (ticker/slug). ----

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  tier          String    @default("free") // matrix is configured later
  role          String    @default("member") // member | reviewer | admin; independent of commercial tier
  // Email is for enrolling and for recovery only; day-to-day sign-in is by password, so
  // routine access never spends the mail provider's quota.
  passwordHash      String?
  // Doubles as revocation: sessions issued before this moment are refused, so changing a
  // password signs out every other device.
  passwordChangedAt DateTime?
  alertWebhookUrl String? // https destination for fired alerts; validated before every POST
  createdAt     DateTime  @default(now())

  watchlist WatchlistItem[]
  rules     AlertRule[]
  auditLogs AuditLog[]
  accounts  Account[]
  sessions  Session[]
  apiKeys   ApiKey[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  expires_in         Int?
  ext_expires_in     Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  oauth_token        String?
  oauth_token_secret String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  kind      String // asset | institution | theme
  refId     String // asset ticker, institution slug, or theme keyword
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, refId])
}

model AlertRule {
  id          String   @id @default(cuid())
  userId      String
  name        String
  type        String // consensus threshold/change | NEW_RESEARCH
  scopeKind   String   @default("asset") // asset | institution | theme | market
  scopeRef    String? // ticker, institution slug, or theme keyword
  assetTicker String? // legacy compatibility; new rules use scopeKind/scopeRef
  threshold   Float
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  events AlertEvent[]

  @@index([userId, active])
  @@index([scopeKind, scopeRef])
}

model AlertEvent {
  id          String   @id @default(cuid())
  ruleId      String
  firedAt     DateTime @default(now())
  message     String
  targetId    String? // article or other source object that caused the event
  assetTicker String?
  score       Int?

  // An alert nobody is told about is a log line. Delivery state is tracked so an
  // undelivered alert is visible as a failure instead of silently sitting in the table.
  deliveryStatus   String    @default("pending") // pending | sent | failed | skipped
  deliveryAttempts Int       @default(0)
  deliveredAt      DateTime?
  deliveryError    String?

  rule AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, firedAt])
  @@index([ruleId, targetId])
  @@index([deliveryStatus, firedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model JobRun {
  id         String    @id @default(cuid())
  name       String
  status     String    @default("running") // running | succeeded | failed
  attempt    Int       @default(1)
  parameters String    @default("{}")
  metrics    String    @default("{}")
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([name, startedAt])
  @@index([status, startedAt])
}

model WorkerHeartbeat {
  name       String   @id
  status     String   @default("running")
  details    String   @default("{}")
  startedAt  DateTime @default(now())
  lastSeenAt DateTime @updatedAt

  @@index([lastSeenAt])
}

// A machine consumer of the public API. The secret itself is never stored: only its
// SHA-256 digest, so a database leak cannot be replayed against the API. `prefix` is the
// short visible half an operator recognises a key by in the admin screen.
model ApiKey {
  id           String    @id @default(cuid())
  name         String // who the key was issued to
  prefix       String    @unique
  tokenHash    String    @unique
  scopes       String    @default("[\"research:read\"]") // JSON array
  rateLimit    Int       @default(60) // requests per minute
  createdById  String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  requestCount Int       @default(0)
  revokedAt    DateTime? // set instead of deleting, so past usage stays auditable

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([revokedAt])
}
