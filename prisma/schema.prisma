// Institutional Intelligence — Phase 1 schema (SQLite dev).
// Swap datasource to postgresql + add pgvector columns for production search.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Institution {
  id                  String    @id @default(cuid())
  slug                String    @unique
  name                String
  country             String?
  homepage            String?
  researchUrl         String
  rssUrl              String?
  sitemapUrl          String?
  rating              Int       @default(4) // stars 3..5 from the source list
  authorityScore      Float     @default(0.85) // 0..1 weight used by the consensus engine
  priority            Int       @default(3) // 1 = phase-1 high-value source
  updateFreq          String? // annual estimate from the source list
  language            String    @default("en")
  crawlPolicy         String    @default("allowed") // allowed | delayed | blocked | manual (from robots audit)
  monitoringEnabled   Boolean   @default(true) // operational pause; never overrides crawlPolicy
  crawlDelay          Int? // seconds; from robots Crawl-delay, honored by the crawler
  requiresRender      Boolean   @default(false) // explicit opt-in for public JS-rendered pages
  crawlIntervalSec    Int? // null selects RSS/static/render defaults (60/180/600 seconds)
  nextCrawlAt         DateTime?
  consecutiveFailures Int       @default(0)
  lastCrawlAt         DateTime?
  lastCrawlStatus     String? // running | succeeded | empty | paused | refused | failed
  lastCrawlMessage    String?
  lastSuccessAt       DateTime?
  lastDiscoveredAt    DateTime?
  createdAt           DateTime  @default(now())

  articles       Article[]
  forecasts      Forecast[]
  macroForecasts MacroForecast[]

  @@index([monitoringEnabled, nextCrawlAt])
}

model Article {
  id             String   @id @default(cuid())
  slug           String   @unique
  institutionId  String
  title          String
  author         String?
  publishedAt    DateTime
  sourceUrl      String
  language       String   @default("en")
  urlHash        String   @unique
  titleHash      String
  contentHash    String
  rawText        String? // canonical cleaned English body; access is permission-controlled
  disclaimerText String? // publisher legal disclosure, excluded from analysis/translation
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  // Model-call backoff, one pair per pipeline because the two fail independently: a body
  // the translator chokes on is usually still analysable. Without these an article that
  // can never be processed stays in the candidate set and is re-billed on every pass —
  // the scheduler picks the newest 50 every minute, so a permanent failure is a permanent
  // cost. Counters reset to zero on success; see src/lib/articleBackoff.ts.
  analysisFailCount        Int       @default(0)
  analysisNextAttemptAt    DateTime?
  translationFailCount     Int       @default(0)
  translationNextAttemptAt DateTime?

  institution    Institution          @relation(fields: [institutionId], references: [id])
  analysis       Analysis?
  articleAssets  ArticleAsset[]
  segments       ArticleSegment[]
  translations   ArticleTranslation[]
  documents      ArticleDocument[]
  atomicViews    AtomicView[]
  figures        ArticleFigure[]
  macroForecasts MacroForecast[]
  contentRetries ContentRetry[]

  @@index([institutionId, publishedAt])
  // The home feed and /research order globally by recency; without this the planner sorts the whole table.
  @@index([publishedAt])
  @@index([titleHash])
  @@index([contentHash])
  // The processing CLIs select "not yet done and due for another attempt", newest first.
  @@index([analysisFailCount, analysisNextAttemptAt])
  @@index([translationFailCount, translationNextAttemptAt])
}

model AtomicView {
  id            String   @id @default(cuid())
  articleId     String
  position      Int
  viewEn        String
  viewZh        String
  type          String // forecast | target | direction | conditional | risk | rationale | market_impact
  asset         String
  assetTicker   String?
  topic         String
  direction     String // bullish | bearish | neutral | conditional
  timeHorizon   String
  value         String?
  conditionEn   String?
  conditionZh   String?
  rationaleEn   String?
  rationaleZh   String?
  confidence    String // high | medium | low
  importance    Int // 1..5
  sourceQuote   String
  provider      String
  model         String
  promptVersion String
  reviewStatus  String   @default("ok")
  createdAt     DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, position])
  @@index([assetTicker, direction])
  @@index([type, importance])
  @@index([topic])
}

model Analysis {
  id               String   @id @default(cuid())
  articleId        String   @unique
  summary          String
  summaryZh        String?
  /// A title written for search, not for the page heading.
  ///
  /// Publisher titles are written for a reader who already has the PDF open: "The
  /// Commodities Feed", "EcoWeek 2", "Fixed Income". They name the series rather than the
  /// subject, so a search engine has nothing to match a query against. This one leads with
  /// what the report is actually about. The publisher's own title still heads the page —
  /// attribution does not change because search needs something else.
  seoTitle         String?
  keyArguments     String   @default("[]") // JSON string
  keyArgumentsZh   String   @default("[]")
  keyNumbers       String   @default("[]") // JSON string [{label,value}]
  keyNumbersZh     String   @default("[]")
  risks            String   @default("[]") // JSON string
  risksZh          String   @default("[]")
  interpretation   String? // AI trading interpretation
  interpretationZh String?
  importanceScore  Float    @default(0.5)
  confidence       Float    @default(0.6)
  provider         String   @default("local")
  model            String   @default("mock-rules-v1")
  promptVersion    String   @default("v1")
  reviewStatus     String   @default("ok") // ok | needs_review
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model ArticleSegment {
  id        String  @id @default(cuid())
  articleId String
  position  Int
  heading   String?
  text      String

  article            Article                     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  translatedSegments ArticleTranslationSegment[]

  @@unique([articleId, position])
  @@index([articleId])
}

model ArticleFigure {
  id                   String   @id @default(cuid())
  articleId            String
  afterSegmentPosition Int // render after the body segment at this position; identical in EN and ZH
  ordinal              Int // order among figures sharing the same anchor
  storageKey           String
  mimeType             String   @default("image/jpeg")
  sourceUrl            String
  alt                  String?
  caption              String?
  width                Int?
  height               Int?
  byteSize             Int?
  createdAt            DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, afterSegmentPosition, ordinal])
  @@index([articleId])
}

model ArticleTranslation {
  id              String   @id @default(cuid())
  articleId       String
  locale          String   @default("zh-CN")
  title           String
  text            String
  provider        String
  model           String
  promptVersion   String
  glossaryVersion String
  status          String   @default("translated") // translated | reviewed | needs_review
  qualityScore    Float?
  translatedAt    DateTime @default(now())
  updatedAt       DateTime @updatedAt

  article   Article                     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  segments  ArticleTranslationSegment[]
  documents ArticleDocument[]

  @@unique([articleId, locale])
  @@index([status, translatedAt])
}

model ArticleTranslationSegment {
  id              String  @id @default(cuid())
  translationId   String
  sourceSegmentId String
  position        Int
  heading         String?
  text            String

  translation   ArticleTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)
  sourceSegment ArticleSegment     @relation(fields: [sourceSegmentId], references: [id], onDelete: Cascade)

  @@unique([translationId, position])
  @@index([sourceSegmentId])
}

model ArticleDocument {
  id            String   @id @default(cuid())
  articleId     String
  translationId String?
  kind          String // source_native | original_pdf | translation_pdf
  locale        String
  storageKey    String
  contentHash   String?
  mimeType      String   @default("application/pdf")
  pageCount     Int?
  byteSize      Int?
  sourceUrl     String?
  status        String   @default("pending") // pending | processing | ready | failed
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  article     Article             @relation(fields: [articleId], references: [id], onDelete: Cascade)
  translation ArticleTranslation? @relation(fields: [translationId], references: [id], onDelete: SetNull)

  @@unique([articleId, kind, locale])
  @@index([status, createdAt])
}

/// Operator-requested reprocessing of one article's AI output, with the outcome recorded.
/// Without the outcome a "retry" is just a wish: the point is being able to say whether the
/// rerun actually improved the score, left it alone, or failed.
model ContentRetry {
  id            String    @id @default(cuid())
  articleId     String
  kind          String // analysis | translation
  status        String    @default("queued") // queued | running | succeeded | failed
  requestedById String?
  requestedAt   DateTime  @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  attempt       Int       @default(0)
  scoreBefore   Float?
  scoreAfter    Float?
  error         String?

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, kind])
  @@index([status, requestedAt])
}

model Asset {
  id         String @id @default(cuid())
  ticker     String @unique
  name       String
  assetClass String // equity | rate | fx | commodity | crypto | macro
  aliases    String @default("[]") // JSON string of match terms

  articleAssets     ArticleAsset[]
  forecasts         Forecast[]
  consensusHistory  ConsensusHistory[]
  priceObservations PriceObservation[]
}

model ArticleAsset {
  id             String   @id @default(cuid())
  articleId      String
  assetId        String
  direction      Int // -2 strong bear .. +2 strong bull
  target         Float?
  previousTarget Float?
  timeHorizon    String? // 1W | 1M | 3M | 12M
  confidence     Float    @default(0.6)
  createdAt      DateTime @default(now())

  article  Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  asset    Asset     @relation(fields: [assetId], references: [id])
  forecast Forecast?

  @@unique([articleId, assetId])
  @@index([assetId, direction])
}

model Forecast {
  id               String    @id @default(cuid())
  institutionId    String
  assetId          String
  articleAssetId   String?   @unique
  forecastDate     DateTime
  targetDate       DateTime?
  targetValue      Float?
  metric           String?
  direction        Int?
  status           String    @default("pending") // pending | settled
  baseValue        Float?
  actualValue      Float?
  absoluteError    Float?
  percentageError  Float?
  directionCorrect Boolean?
  settlementSource String?
  settledAt        DateTime?

  institution  Institution   @relation(fields: [institutionId], references: [id])
  asset        Asset         @relation(fields: [assetId], references: [id])
  articleAsset ArticleAsset? @relation(fields: [articleAssetId], references: [id], onDelete: Cascade)

  @@index([assetId, forecastDate])
  @@index([institutionId, status])
  @@index([status, targetDate])
}

model PriceObservation {
  id        String   @id @default(cuid())
  assetId   String
  timestamp DateTime
  value     Float
  source    String
  sourceRef String?
  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, timestamp, source])
  @@index([assetId, timestamp])
}

model ConsensusHistory {
  id               String   @id @default(cuid())
  assetId          String
  timestamp        DateTime @default(now())
  consensusScore   Int // 0..100
  institutionCount Int
  bullishCount     Int
  neutralCount     Int
  bearishCount     Int

  asset Asset @relation(fields: [assetId], references: [id])

  @@index([assetId, timestamp])
}

// ---- Macro Intelligence. Independent from Article ingest and Institutional Consensus. ----

model MacroIndicator {
  id                 String   @id @default(cuid())
  canonicalKey       String   @unique
  nameEn             String
  nameZh             String?
  countryCode        String
  currency           String?
  category           String
  frequency          String
  unit               String
  seasonalAdjustment String?
  importance         Int      @default(3)
  enabled            Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  seriesSources MacroSeriesSource[]
  releaseValues MacroReleaseValue[]

  @@index([countryCode, category, enabled])
}

model MacroSeriesSource {
  id               String   @id @default(cuid())
  indicatorId      String
  provider         String
  externalSeriesId String
  dataset          String?
  tableCode        String?
  lineCode         String?
  priority         Int      @default(100)
  sourceUrl        String?
  metadata         String? // JSON string; SQLite has no Prisma Json support
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  indicator    MacroIndicator     @relation(fields: [indicatorId], references: [id], onDelete: Restrict)
  observations MacroObservation[]

  @@unique([provider, externalSeriesId])
  @@index([indicatorId, enabled, priority])
}

model MacroObservation {
  id                String    @id @default(cuid())
  seriesSourceId    String
  period            DateTime
  value             Decimal
  vintageAt         DateTime
  fetchedAt         DateTime
  isInitial         Boolean   @default(false)
  revisionNo        Int       @default(0)
  status            String    @default("PUBLISHED")
  sourcePublishedAt DateTime?
  rawHash           String?
  metadata          String? // JSON string
  createdAt         DateTime  @default(now())

  seriesSource MacroSeriesSource @relation(fields: [seriesSourceId], references: [id], onDelete: Restrict)

  @@unique([seriesSourceId, period, vintageAt])
  @@unique([seriesSourceId, period, revisionNo])
  @@index([seriesSourceId, vintageAt])
  @@index([period, status])
}

model MacroRelease {
  id                String    @id @default(cuid())
  releaseKey        String    @unique
  releaseFamily     String
  countryCode       String
  currency          String?
  agency            String
  titleEn           String
  titleZh           String?
  scheduledAt       DateTime
  sourceTimezone    String
  releasedAt        DateTime?
  importance        Int       @default(3)
  status            String    @default("SCHEDULED")
  sourceUrl         String?
  externalReleaseId String?
  analysisEn        String? // AI read-out generated on release (actual vs consensus/previous)
  analysisZh        String?
  analysisAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  values          MacroReleaseValue[]
  policyDocuments MacroPolicyDocument[]

  @@index([status, scheduledAt])
  @@index([releaseFamily, scheduledAt])
  @@index([agency, externalReleaseId])
}

model MacroForecast {
  id              String   @id @default(cuid())
  institutionId   String
  indicatorKey    String // canonical indicator key, e.g. US_NFP
  referencePeriod DateTime // first day of the forecast month/quarter
  value           Float
  unit            String?
  quote           String?
  articleId       String? // source research article
  asOf            DateTime // article publication time (recency for de-duplication)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  article     Article?    @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@unique([institutionId, indicatorKey, referencePeriod])
  @@index([indicatorKey, referencePeriod])
}

model MacroReleaseValue {
  id                       String    @id @default(cuid())
  releaseId                String
  indicatorId              String
  observationPeriod        DateTime
  actualInitial            Decimal?
  previousAtRelease        Decimal?
  revisedPreviousAtRelease Decimal?
  consensusAtRelease       Decimal?
  consensusProvider        String?
  consensusAsOf            DateTime?
  surpriseRaw              Decimal?
  surprisePct              Decimal?
  fetchedAt                DateTime
  createdAt                DateTime  @default(now())

  release   MacroRelease   @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  indicator MacroIndicator @relation(fields: [indicatorId], references: [id], onDelete: Restrict)

  @@unique([releaseId, indicatorId])
  @@index([indicatorId, observationPeriod])
}

// Human-approved outbound publishing. Source ids deliberately stay polymorphic: research
// and macro records have different lifecycles, while a draft must survive either being removed.
model SocialDraft {
  id               String    @id @default(cuid())
  sourceKind       String // research | macro
  sourceId         String
  title             String
  textEn            String
  textZh            String
  routeSnapshot     String    @default("[]")
  version           Int       @default(1)
  status            String    @default("PENDING_REVIEW")
  feishuMessageId   String?
  notifyAttempts    Int       @default(0)
  notifyError       String?
  notifiedAt        DateTime?
  approvedById      String?
  approvedAt        DateTime?
  rejectedById      String?
  rejectedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  deliveries SocialDelivery[]

  @@unique([sourceKind, sourceId])
  @@index([status, createdAt])
}

model SocialAccount {
  id                 String    @id @default(cuid())
  platform           String    @default("x")
  label              String
  language           String // en | zh-CN
  externalAccountId  String?
  externalUsername   String?
  accessTokenCipher  String?
  refreshTokenCipher String?
  tokenExpiresAt     DateTime?
  enabled            Boolean   @default(false)
  lastError          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  routes     SocialRoute[]
  deliveries SocialDelivery[]

  @@index([platform, enabled])
  @@unique([platform, externalAccountId])
}

// OAuth application credentials shared by every account on a platform. The client secret
// is encrypted; only its last four characters are ever shown in the console.
model SocialPlatformCredential {
  platform           String   @id
  clientId           String
  clientSecretCipher String?
  clientSecretHint   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SocialRoute {
  id         String   @id @default(cuid())
  sourceKind String // research | macro
  accountId  String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  account SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([sourceKind, accountId])
  @@index([sourceKind, enabled])
}

model SocialDelivery {
  id           String    @id @default(cuid())
  draftId      String
  accountId    String
  language     String
  status       String    @default("PENDING")
  mainPostId   String?
  replyPostId  String?
  attempts     Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError    String?
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  draft   SocialDraft   @relation(fields: [draftId], references: [id], onDelete: Cascade)
  account SocialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([draftId, accountId])
  @@index([status, nextAttemptAt])
}

model MacroPolicyDocument {
  id            String    @id @default(cuid())
  releaseId     String?
  centralBank   String
  docType       String
  meetingDate   DateTime?
  publishedAt   DateTime
  sourceUrl     String
  rawText       String
  contentHash   String
  parsedJson    String? // JSON string
  provider      String?
  model         String?
  promptVersion String?
  reviewStatus  String    @default("unparsed")
  fetchedAt     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  release MacroRelease? @relation(fields: [releaseId], references: [id], onDelete: SetNull)

  @@unique([sourceUrl, contentHash])
  @@index([releaseId])
  @@index([centralBank, docType, publishedAt])
  @@index([contentHash])
}

model MacroSyncState {
  id            String    @id @default(cuid())
  provider      String
  scopeKey      String
  cursor        String?
  etag          String?
  lastModified  String?
  lastAttemptAt DateTime?
  lastSuccessAt DateTime?
  lastStatus    String    @default("never")
  lastError     String?
  metadata      String? // JSON string
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([provider, scopeKey])
  @@index([lastStatus, lastSuccessAt])
}

model MarketInstrument {
  id            String   @id @default(cuid())
  symbol        String   @unique
  baseAsset     String
  quoteCurrency String
  assetClass    String
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  observations MarketObservation[]

  @@index([assetClass, enabled])
}

model MarketObservation {
  id             String   @id @default(cuid())
  instrumentId   String
  provider       String
  externalSymbol String
  observedAt     DateTime
  fetchedAt      DateTime
  interval       String
  quoteCurrency  String
  quality        String
  status         String
  open           Decimal?
  high           Decimal?
  low            Decimal?
  close          Decimal
  sourceUrl      String?
  rawHash        String?
  metadata       String?
  createdAt      DateTime @default(now())

  instrument MarketInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([provider, externalSymbol, observedAt, interval])
  @@index([instrumentId, observedAt])
  @@index([quality, fetchedAt])
}

model MacroSignalSnapshot {
  id                  String   @id @default(cuid())
  scopeKey            String   @default("GLOBAL")
  methodologyVersion  String
  generatedAt         DateTime
  contextJson         String
  inputReleaseIds     String
  inputObservationIds String
  createdAt           DateTime @default(now())

  @@index([scopeKey, generatedAt])
  @@index([methodologyVersion, generatedAt])
}

// ---- User side (Phase 2). Refs to assets/institutions are scalar (ticker/slug). ----

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  emailVerified     DateTime?
  name              String?
  image             String?
  tier              String    @default("free") // matrix is configured later
  role              String    @default("member") // member | reviewer | admin; independent of commercial tier
  // Email is for enrolling and for recovery only; day-to-day sign-in is by password, so
  // routine access never spends the mail provider's quota.
  passwordHash      String?
  // Doubles as revocation: sessions issued before this moment are refused, so changing a
  // password signs out every other device.
  passwordChangedAt DateTime?
  alertWebhookUrl   String? // https destination for fired alerts; validated before every POST
  // An operator suspension. Kept as a timestamp rather than a flag so the record says
  // when access was withdrawn, and restoring is a single field back to null.
  suspendedAt       DateTime?
  // Written at most once every ten minutes per user, so "who is still using this" is
  // answerable without a write on every request.
  lastSeenAt        DateTime?
  note              String? // operator-only remark, never shown to the account holder
  createdAt         DateTime  @default(now())

  watchlist WatchlistItem[]
  rules     AlertRule[]
  auditLogs AuditLog[]
  accounts  Account[]
  sessions  Session[]
  apiKeys   ApiKey[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  expires_in         Int?
  ext_expires_in     Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  oauth_token        String?
  oauth_token_secret String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  kind      String // asset | institution | theme
  refId     String // asset ticker, institution slug, or theme keyword
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, refId])
}

model AlertRule {
  id          String   @id @default(cuid())
  userId      String
  name        String
  type        String // consensus threshold/change | NEW_RESEARCH
  scopeKind   String   @default("asset") // asset | institution | theme | market
  scopeRef    String? // ticker, institution slug, or theme keyword
  assetTicker String? // legacy compatibility; new rules use scopeKind/scopeRef
  threshold   Float
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  events AlertEvent[]

  @@index([userId, active])
  @@index([scopeKind, scopeRef])
}

model AlertEvent {
  id          String   @id @default(cuid())
  ruleId      String
  firedAt     DateTime @default(now())
  message     String
  targetId    String? // article or other source object that caused the event
  assetTicker String?
  score       Int?

  // An alert nobody is told about is a log line. Delivery state is tracked so an
  // undelivered alert is visible as a failure instead of silently sitting in the table.
  deliveryStatus   String    @default("pending") // pending | sent | failed | skipped
  deliveryAttempts Int       @default(0)
  deliveredAt      DateTime?
  deliveryError    String?

  rule AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, firedAt])
  @@index([ruleId, targetId])
  @@index([deliveryStatus, firedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model JobRun {
  id         String    @id @default(cuid())
  name       String
  status     String    @default("running") // running | succeeded | failed
  attempt    Int       @default(1)
  parameters String    @default("{}")
  metrics    String    @default("{}")
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([name, startedAt])
  @@index([status, startedAt])
}

model WorkerHeartbeat {
  name       String   @id
  status     String   @default("running")
  details    String   @default("{}")
  startedAt  DateTime @default(now())
  lastSeenAt DateTime @updatedAt

  @@index([lastSeenAt])
}

// A machine consumer of the public API. The secret itself is never stored: only its
// SHA-256 digest, so a database leak cannot be replayed against the API. `prefix` is the
// short visible half an operator recognises a key by in the admin screen.
model ApiKey {
  id           String    @id @default(cuid())
  name         String // who the key was issued to
  prefix       String    @unique
  tokenHash    String    @unique
  scopes       String    @default("[\"research:read\"]") // JSON array
  rateLimit    Int       @default(60) // requests per minute
  createdById  String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  requestCount Int       @default(0)
  revokedAt    DateTime? // set instead of deleting, so past usage stays auditable

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([revokedAt])
}

// ---- Audience analytics (Phase 3). Cookie-less and IP-free by construction. ----

// One page view.
//
// `visitorId` is a digest of (secret + UTC day + IP + user agent): the same reader is one
// visitor for the length of a day and unlinkable to their own next day, and the address
// they came from is never stored. That is deliberately weaker than a tracking cookie —
// it is enough to count people, and not enough to follow one.
model PageView {
  id           String   @id @default(cuid())
  ts           DateTime @default(now())
  day          String // UTC YYYY-MM-DD, so rollup and pruning need no date arithmetic
  path         String // language prefix and query string already removed
  locale       String   @default("en")
  visitorId    String
  sessionId    String // minted in the tab, reset after 30 idle minutes
  userId       String? // present only while signed in
  isEntry      Boolean  @default(false)
  referrerHost String? // host only; a full referrer can carry someone else's query
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  country      String?
  device       String   @default("desktop") // desktop | mobile | tablet
  os           String?
  browser      String?
  durationMs   Int? // filled by the unload beacon; null when the reader left abruptly

  @@index([day, path])
  @@index([ts])
  @@index([visitorId, ts])
  @@index([sessionId, ts])
  @@index([userId, ts])
}

// A named thing someone did: a search, a download, an alert created. Same identity
// model as PageView, so events and views can be counted against the same visitors.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  ts        DateTime @default(now())
  day       String
  name      String
  path      String?
  visitorId String
  sessionId String
  userId    String?
  value     Float?
  metadata  String   @default("{}")

  @@index([day, name])
  @@index([ts])
  @@index([userId, ts])
}

// Core Web Vitals as the reader's own browser measured them. Field data, not a lab score.
model WebVital {
  id     String   @id @default(cuid())
  ts     DateTime @default(now())
  day    String
  metric String // LCP | CLS | INP | FCP | TTFB
  value  Float
  rating String // good | needs-improvement | poor
  path   String
  device String   @default("desktop")

  @@index([day, metric])
  @@index([ts])
}

// The daily aggregate. Raw rows above are pruned after the retention window; these are
// kept, so a year-on-year comparison survives without keeping a year of page views.
model TrafficDaily {
  id          String @id @default(cuid())
  day         String
  dimension   String // total | path | referrer | country | device | browser | os | locale | utm_source | utm_medium | utm_campaign | event
  value       String // empty string for dimension=total
  views       Int    @default(0)
  visitors    Int    @default(0)
  sessions    Int    @default(0)
  bounces     Int    @default(0)
  durationSec Int    @default(0)

  @@unique([day, dimension, value])
  @@index([dimension, day])
}

// API traffic, aggregated as it arrives rather than logged row by row: a request log
// would be the largest table here and answer nothing this does not.
model ApiUsageDaily {
  id String @id @default(cuid())

  day      String
  // Empty string for a request that never authenticated, rather than null: both databases
  // treat NULL as distinct from itself in a unique index, so a nullable column here would
  // make the upsert below insert a fresh row for every anonymous call instead of counting.
  keyId    String @default("")
  endpoint String
  status   Int
  count    Int    @default(0)
  totalMs  Int    @default(0)

  @@unique([day, keyId, endpoint, status])
  @@index([day])
  @@index([keyId, day])
}

/// Model-provider credentials and defaults, editable from the console.
///
/// The key is stored encrypted and is never sent back to the browser — the console shows
/// only `apiKeyHint` (last four characters), which is enough to tell two keys apart and
/// useless to anyone who reads it. Environment variables still work and act as the
/// fallback, so an existing deployment keeps running until someone saves a key here.
model LlmProvider {
  provider       String    @id // anthropic | openai | deepseek | gemini
  apiKeyCipher   String? // AES-256-GCM, see src/lib/secrets.ts
  apiKeyHint     String?
  baseUrl        String?
  defaultModel   String?
  enabled        Boolean   @default(true)
  lastCheckedAt  DateTime?
  lastCheckOk    Boolean?
  lastCheckError String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// Which provider and model serve each model-backed task.
///
/// One row per task rather than one global setting, because the tasks are not equally
/// valuable: bulk translation wants the cheapest model that is accurate, while the
/// independent review that judges it should not be the same model marking its own work.
model LlmTaskRoute {
  task      String   @id // translation | translation_review | analysis | forecast | release_analysis | policy | retitle
  provider  String? // null falls back to the default provider order
  model     String? // null uses the provider's default model
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

/// Per-model prices, so recorded tokens can be shown as money.
///
/// Deliberately empty until an operator fills it in: published prices change and differ by
/// account, and a number invented here would be reported as if it were fact.
model LlmModelPrice {
  id            String   @id @default(cuid())
  provider      String
  model         String
  inputPerMTok  Float
  outputPerMTok Float
  currency      String   @default("USD")
  updatedAt     DateTime @updatedAt

  @@unique([provider, model])
}

/// One row per model call, with the token counts the provider itself reported.
///
/// Every provider returns usage on the response and the pipeline was throwing it away, so
/// the only way to answer "what did that cost" was to estimate from character counts.
/// These are measured, not inferred. Pruned by the analytics rollup.
model LlmCall {
  id   String @id @default(cuid())
  /// UTC day, matching the convention the audience counters already use. Grouping by a
  /// stored day string keeps the reports portable: date extraction differs between SQLite
  /// and PostgreSQL, and a per-row date function cannot use an index in either.
  day  String
  task String

  provider     String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  durationMs   Int      @default(0)
  ok           Boolean  @default(true)
  /// Why the model stopped, normalised across vendors: "stop" (finished on its own),
  /// "length" (hit the output ceiling and was cut mid-answer), "filter", or whatever else
  /// the vendor reported. Truncation is invisible in the token counts — a cut-off reply
  /// bills for every token it generated — and it is the difference between "the ceiling is
  /// fine" and "the ceiling is why this call is being retried".
  finishReason String?
  error        String?
  createdAt    DateTime @default(now())

  @@index([day])
  @@index([day, task])
  @@index([day, provider, model])
  @@index([createdAt])
}

/// A spending ceiling for one scope, enforced automatically before each model call.
///
/// The routing table decides whether a task runs at all; this decides how much it may
/// spend before it stops on its own. `scope` is either the sentinel `*` (every task,
/// summed) or one LlmTask. When a scope's spend in the current period reaches a ceiling,
/// resolveLLMProvider returns null for that task exactly as if it had been switched off,
/// and the console shows why. Enforcement fails open: an unreachable database must not halt
/// the pipeline — LLM_DISABLED is the hard stop that does not depend on a database read.
///
/// A token ceiling is always enforceable; a cost ceiling only bites once the models in play
/// are priced (an unpriced model contributes unknown cost, which cannot be compared).
model LlmBudget {
  scope       String   @id // "*" (global) | translation | analysis | forecast | …
  period      String   @default("month") // "day" | "month", both UTC
  limitTokens Int? // combined input+output ceiling for the period; null = no token cap
  limitCost   Float? // cost ceiling for the period, in the price table's currency; null = no cost cap
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}
