# SQLite for local dev (zero infra). Production deployment uses PostgreSQL.
DATABASE_URL="file:./dev.db"

# Optional multi-provider LLM. Unset = deterministic parser; translation waits safely.
# LLM_PROVIDER="anthropic" # anthropic | openai | deepseek | gemini
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-sonnet-4-5-20250929"
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-5.4"
# DEEPSEEK_API_KEY="sk-..."
# DEEPSEEK_MODEL="deepseek-v4-flash"
# DEEPSEEK_BASE_URL="https://api.deepseek.com"
# GEMINI_API_KEY="AIza..." # free tier: https://aistudio.google.com/apikey
# GEMINI_MODEL="gemini-2.0-flash"
# TRANSLATION_PROVIDER="anthropic"
# TRANSLATION_REVIEW_PROVIDER="openai"
# FORECAST_PROVIDER="deepseek"

# Everything above is now also settable in the console (Platform -> Model providers), which
# takes precedence. These stay as the fallback, so a deployment that never opens the console
# behaves exactly as before.
#
# Encrypts provider keys stored from the console. Falls back to AUTH_SECRET if unset.
# Rotating it makes stored keys unreadable and they must be entered again.
# CONFIG_ENCRYPTION_KEY="a-long-random-value"
# LLM_CONFIG_CACHE_MS="30000"   # how long a worker caches console config before re-reading
# LLM_CALL_RETENTION_DAYS="90"  # per-call usage rows are pruned by the analytics rollup

# Cost controls for the content pipeline.
# Characters per translation request. Larger is cheaper (fewer calls) but past some size the
# model starts dropping segments, which fails the integrity check and re-requests the chunk.
# TRANSLATION_CHUNK_CHARS="6000"
# Share of structurally sound translations that still get the paid independent review.
# Anything the cheap quality signals flag is reviewed regardless of this rate.
# TRANSLATION_REVIEW_SAMPLE_RATE="0.15"
# Per-article backoff after a stage fails, so an unprocessable article stops being re-billed.
# ARTICLE_LLM_MAX_FAILURES="6"
# ARTICLE_LLM_BACKOFF_MS="1800000"
# ARTICLE_LLM_BACKOFF_MAX_MS="86400000"
# Macro read-out generation: attempts before a release is abandoned, and the first backoff.
# MACRO_RELEASE_ANALYSIS_MAX_ATTEMPTS="3"
# MACRO_RELEASE_ANALYSIS_BACKOFF_MS="900000"
# MACRO_RELEASE_ANALYSIS_INTERVAL_MS="900000"

# Private document storage and embedded PDF fonts.
# DOCUMENT_STORAGE_DRIVER="local"
# DOCUMENT_STORAGE_ROOT="./storage"
# DOCUMENT_MAX_BYTES="52428800"
# S3_BUCKET="private-tline-documents"
# S3_REGION="us-east-1"
# S3_PREFIX="tline"
# S3_ENDPOINT="https://s3-compatible-endpoint.example"
# S3_FORCE_PATH_STYLE="false"
# S3_SERVER_SIDE_ENCRYPTION="AES256"
# S3_SIGNED_URL_TTL_SECONDS="300"
# PDF_FONT_EN="/path/to/regular.ttf"
# PDF_FONT_EN_BOLD="/path/to/bold.ttf"
# PDF_FONT_ZH="/path/to/cjk-regular.ttf"
# PDF_FONT_ZH_BOLD="/path/to/cjk-bold.ttf"
# PDF_FONT_ZH_FAMILY="PostScriptNameForTtc"
# PDF_FONT_ZH_BOLD_FAMILY="PostScriptNameForBoldTtc"
# PDF_LAYOUT_FONT_ZH="/path/to/cjk-layout.ttf"

# Required only for institutions explicitly marked requiresRender.
# PLAYWRIGHT_CHROMIUM_PATH="/path/to/chrome-or-edge"

# Scheduler observability/retry policy.
# INGEST_INTERVAL_MS="60000"
# INGEST_CONCURRENCY="2"
# INGEST_SOURCE_SECONDS="90"
# INGEST_ARTICLE_LIMIT="4"
# How far back a discovery pass looks. Older items are skipped, so the parse,
# translation and analysis spend stays on research that is actually current. Seven days
# by default: most desks publish weekly or less, and a shorter window excludes them.
# INGEST_WINDOW_HOURS="168"
# PROCESS_INTERVAL_MS="60000"
# PROCESS_ARTICLE_LIMIT="50"
# REPARSE_CONCURRENCY="2"
# TRANSLATION_CONCURRENCY="2"
# JOB_RETRY_LIMIT="3"
# JOB_RETRY_DELAY_MS="60000"
# JOB_FAILURE_WEBHOOK_URL="https://internal-alert-endpoint.example/hooks/tline"
# Macro scheduler runs as a separate singleton process/container.
# MACRO_CALENDAR_INTERVAL_MS="21600000"
# MACRO_PROVIDER_SYNC_INTERVAL_MS="3600000"
# MACRO_RELEASE_WATCH_INTERVAL_MS="60000"
# MACRO_REVISION_SYNC_INTERVAL_MS="86400000"
# MACRO_POLICY_SYNC_INTERVAL_MS="21600000"
# MACRO_ALERT_INTERVAL_MS="60000"
# Market quote polling. One request per instrument per pass; Twelve Data's free tier
# allows 800/day, so the 30-minute default keeps 7 instruments at ~336 and leaves room
# for a --from= backfill. Raise the frequency only on a paid plan.
# MACRO_MARKET_SYNC_INTERVAL_MS="1800000"
# MACRO_FORECAST_SETTLE_INTERVAL_MS="21600000"
# MACRO_JOB_RETRY_LIMIT="3"
# MACRO_JOB_RETRY_DELAY_MS="30000"

# Signs the session cookie. Use a long random string in production.
AUTH_SECRET="dev-insecure-secret-change-me-in-prod"
ADMIN_EMAILS="owner@example.com"
# AUTH_PROVIDER="email" # email | azure-ad | google
# NEXTAUTH_URL="https://tline.example.com"
# Resend SMTP: verify the sender domain first, then use a restricted API key.
# EMAIL_SERVER="smtp://resend:re_xxxxxxxxx@smtp.resend.com:587"
# EMAIL_FROM="Tline <no-reply@tline.example.com>"
# AZURE_AD_CLIENT_ID=""
# AZURE_AD_CLIENT_SECRET=""
# AZURE_AD_TENANT_ID="common"
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# AUTH_ALLOWED_EMAIL_DOMAINS="example.com,subsidiary.example"
# PRICE_SETTLEMENT_TOLERANCE_DAYS="7"
# Official U.S. macro APIs. BLS key is optional; the other providers require one.
# BLS_API_KEY=""
# BEA_API_KEY=""
# FRED_API_KEY=""
# FRED_DATA_USE_CONFIRMED="false" # enable only after current FRED/series terms are reviewed for this use
# EIA_API_KEY=""
# Licensed market data. Quality defaults to DELAYED; set REALTIME only when the account entitlement guarantees it.
# TWELVE_DATA_API_KEY=""
# TWELVE_DATA_QUALITY="DELAYED" # DELAYED | REALTIME | EOD
# TWELVE_DATA_DECLARED_DELAY_SECONDS="900" # contractual/provider-declared delay, not our sampling interval
# MARKET_BUDGET_PER_MINUTE="8"
# MARKET_BUDGET_PER_DAY="800"
# MARKET_BUDGET_RESET_TIMEZONE="UTC"
# MARKET_QUOTE_ENDPOINT_WEIGHT="1"
# MARKET_TIME_SERIES_ENDPOINT_WEIGHT="1"
# THEME_MARKET_MIN_COVERAGE="0.6"
# Email-only sign-in is preview-only and disabled in production unless explicitly opted in.
# ALLOW_INSECURE_DEMO_AUTH="false"

# ---- Public site identity ----
# Canonical origin used by robots.txt, sitemap.xml and Open Graph URLs.
# Production validation requires this value and it must use HTTPS.
# SITE_URL="https://tlines.tech"
# Comma-separated official organization profile URLs; leave empty rather than inventing identities.
# BRAND_SAME_AS="https://www.linkedin.com/company/your-official-profile"

# ---- Health endpoint ----
# /api/health returns only { status } to anonymous callers. Operators with an admin
# session see the full detail; an external uptime monitor can use this bearer token.
# HEALTH_DETAIL_TOKEN=""

# ---- Search protection ----
# Fixed-window limit per client on /api/search, which builds an in-memory index.
# SEARCH_RATE_LIMIT="30"
# SEARCH_RATE_WINDOW_MS="60000"
# Upper bound on articles held in the search index; oldest fall out beyond it.
# SEARCH_INDEX_MAX_ARTICLES="1000"
# SEARCH_PREWARM="true"
# How long the index's data-version fingerprint is trusted before it is probed again.
# SEARCH_VERSION_PROBE_MS="10000"

# ---- Content reprocessing ----
# Operator-requested reruns drained per scheduler pass.
# CONTENT_RETRY_BATCH="5"

# ---- Alert delivery ----
# Fired alerts POST to each user's own https webhook; this is the fallback for users
# who have not configured one. Private and loopback addresses are refused.
# ALERT_WEBHOOK_URL=""
# ALERT_DELIVERY_ATTEMPTS="3"

# ---- Human-approved social publishing ----
# X OAuth app. Register https://YOUR_SITE/api/social/x/callback as the callback URL.
# X_CLIENT_ID=""
# X_CLIENT_SECRET=""
# Feishu custom app bot and interactive-card callback credentials.
# FEISHU_APP_ID=""
# FEISHU_APP_SECRET=""
# FEISHU_ENCRYPT_KEY=""
# FEISHU_VERIFICATION_TOKEN=""
# FEISHU_REVIEW_RECEIVE_ID=""
# FEISHU_REVIEW_RECEIVE_ID_TYPE="open_id"
# FEISHU_APPROVER_OPEN_IDS="ou_xxx,ou_yyy"
# SOCIAL_INTERVAL_MS="5000"
# SOCIAL_PUBLISH_ATTEMPTS="6"

# ---- Backups ----
# BACKUP_DIR="backups"
# BACKUP_KEEP="7"

# ---- Audience analytics ----
# First-party, cookie-less measurement. No IP address is ever stored: a visitor is a
# daily-rotating digest of (AUTH_SECRET + UTC day + address + user agent), so a reader is
# countable once per day and unlinkable across days.
# Set to "false" to stop collecting entirely; the console then shows empty dashboards
# rather than breaking.
ANALYTICS_ENABLED="true"
# Honour Do-Not-Track / Global Privacy Control. Costs a fraction of a percent of the
# counts; enable it where the deployment's audience expects it.
ANALYTICS_RESPECT_DNT="false"
# How long raw page views, events and vitals are kept before the rollup job deletes them.
# Daily aggregates are kept indefinitely, so history survives the pruning.
ANALYTICS_RAW_RETENTION_DAYS="90"
# Beacons accepted per address per minute. A page sends roughly one per view plus one on
# leaving, so this is generous for a reader and closed to a script.
ANALYTICS_RATE_LIMIT="120"
# How often the scheduler recomputes daily aggregates and prunes raw rows. Minimum 5 min.
ANALYTICS_ROLLUP_INTERVAL_MS="3600000"
